---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import './styles.scss'

interface Props {
  title: string
  text: string
  quote: string
  name: string
  description: string
  image: ImageMetadata
}

const { title, text, quote, name, description, image } = Astro.props
---

<article class="et--testimonial">
  <div class="bx--grid">
    <div class="bx--row">
      <div class="bx--col-sm-10 bx--col-md-5">
        <blockquote class="et--testimonial__quote">{quote}</blockquote>
      </div>
      <div class="bx--col-md-3">
        <figure class="et--testimonial__figure">
          <Image
            class="et--testimonial__figure__image"
            src={image}
            alt=""
            widths={[280, 560]}
            sizes="(min-width: 672px) 25vw, 100vw"
          />
          <figcaption>
            <p class="et--testimonial__name">{name}</p>
            <p class="et--testimonial__description">{description}</p>
          </figcaption>
        </figure>
      </div>
      <div class="bx--col-md-4">
        <h3 class="et--testimonial__title">{title}</h3>
        <p class="et--testimonial__text">{text}</p>
      </div>
    </div>
  </div>
</article>
