---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import HeroHome from '../components/HeroHome/index.astro'
import Search from '../components/Search/index.astro'
import TeaserGroup from '../components/TeaserGroup/index.astro'
import CardCarousel from '../components/CardCarousel/index.astro'
import TestimonialGroup from '../components/TestimonialGroup/index.astro'
import Partners from '../components/Partners/index.astro'
import Footer from '../components/Footer/index.astro'

interface Props {
  data: CollectionEntry<'pages'>['data']
}

const { data } = Astro.props
---

<BaseLayout>
  <HeroHome>
    <slot />
  </HeroHome>
  <Search />
  <main>
    <TeaserGroup teasers={data.teasers ?? []} />
    <CardCarousel cards={data.cards ?? []} />
    <TestimonialGroup testimonials={data.testimonials ?? []} />
    <Partners partners={data.partners ?? []} />
  </main>
  <Footer />
</BaseLayout>
