---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import HeroFeatured from '../components/HeroFeatured/index.astro'
import Search from '../components/Search/index.astro'
import Footer from '../components/Footer/index.astro'

interface Props {
  data: CollectionEntry<'pages'>['data']
}

const { data } = Astro.props
---

<BaseLayout title={data.title} description={data.lead} image={data.metaImage}>
  <HeroFeatured
    image={data.image!}
    title={data.title!}
    lead={data.lead!}
    link={data.link!}
  />
  <main class="et--markdown et--markdown--listing">
    <div class="bx--grid">
      <div class="bx--row">
        <slot />
      </div>
    </div>
  </main>
  <Search />
  <Footer />
</BaseLayout>
