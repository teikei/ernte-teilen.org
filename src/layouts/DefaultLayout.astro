---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import Footer from '../components/Footer/index.astro'

interface Props {
  data: CollectionEntry<'pages'>['data']
}

const { data } = Astro.props
---

<BaseLayout title={data.title} image={data.metaImage}>
  <main class="et--markdown">
    <div class="et--grid">
      <div class="et--row">
        <div class="et--col-sm-8">
          <h1>{data.title}</h1>
          <slot />
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
