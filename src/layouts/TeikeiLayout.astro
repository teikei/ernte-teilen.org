---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import TeikeiBundle from '../components/TeikeiBundle.astro'
import { teikeiConfig } from '../config/site'

interface Props {
  data: CollectionEntry<'pages'>['data']
}

const { data } = Astro.props
const { embed, apiBaseUrl, assetsBaseUrl } = teikeiConfig
---

<BaseLayout title={data.title} fixedHeader>
  <div
    id="teikei-app"
    data-locale="de"
    data-base-url="/karte#"
    data-country="DE"
    data-api-base-url={apiBaseUrl}
    data-assets-base-url={assetsBaseUrl}
    style={embed === 'loader' ? 'height: 100vh; padding-top: 100px' : undefined}
  >
  </div>
  <TeikeiBundle host="app" />
</BaseLayout>
