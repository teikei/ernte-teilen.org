---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import Hero from '../components/Hero/index.astro'
import Features from '../components/Features/index.astro'
import Search from '../components/Search/index.astro'
import Footer from '../components/Footer/index.astro'

interface Props {
  data: CollectionEntry<'pages'>['data']
}

const { data } = Astro.props
---

<BaseLayout title={data.title} description={data.lead} image={data.metaImage}>
  <Hero title={data.title!} lead={data.lead!} link={data.link!} />
  <Features features={data.features ?? []} />
  <main
    class="et--markdown et--markdown--listing et--markdown--listing--wide"
  >
    <div class="et--grid">
      <div class="et--row">
        <slot />
      </div>
    </div>
  </main>
  <Search />
  <Footer />
</BaseLayout>
