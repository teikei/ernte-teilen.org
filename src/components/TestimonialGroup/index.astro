---
import { getAssetImages } from '../../lib/images'
import Testimonial from '../Testimonial/index.astro'
import './styles.scss'

interface TestimonialItem {
  slug: string
  title: string
  text: string
  quote: string
  name: string
  description: string
}

interface Props {
  testimonials: TestimonialItem[]
}

const { testimonials } = Astro.props
const testimonialImages = getAssetImages('testimonials')
---

<div class="et--testimonial-group">
  {
    testimonials.map(({ slug, title, text, quote, name, description }) => (
      <Testimonial
        title={title}
        text={text}
        quote={quote}
        name={name}
        description={description}
        image={testimonialImages[slug]}
      />
    ))
  }
</div>
