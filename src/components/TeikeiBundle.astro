---
// Injects the externally maintained teikei map/search app via its loader.
// `teikei-loader.js` mounts the bundle given in `data-js` into the element
// matched by `data-host` (#teikei-app for the map, #teikei-search for the
// homepage search widget).
import { teikeiConfig } from '../config/site'

interface Props {
  host: 'app' | 'search'
}

const { host } = Astro.props
const { bundlesUrl } = teikeiConfig

const bundleUrl =
  host === 'app'
    ? `${bundlesUrl}/main.js`
    : `${bundlesUrl}/widgets/search-widget.js`
---

<link rel="modulepreload" href={bundleUrl} />
<script
  is:inline
  type="module"
  src={`${bundlesUrl}/teikei-loader.js`}
  data-teikei-loader="true"
  data-js={bundleUrl}
  data-host={`#teikei-${host}`}
></script>
