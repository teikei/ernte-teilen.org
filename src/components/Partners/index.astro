---
import { Image } from 'astro:assets'
import { getAssetImages } from '../../lib/images'
import './styles.scss'

interface PartnerItem {
  slug: string
  name: string
  url: string
}

interface PartnerGroup {
  id: string
  title: string
  items: PartnerItem[]
}

interface Props {
  partners: PartnerGroup[]
}

const { partners } = Astro.props
const partnerImages = getAssetImages('partners')
---

<section class="et--partners et--grid">
  {
    partners.map(({ title, items, id }) => (
      <div id={id} class="et--partners__group">
        <h3 class="et--partners__title">{title}</h3>
        <ul>
          {items.map(({ slug, name, url }) => (
            <li>
              <a
                class="et--partners__link"
                href={url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Image
                  src={partnerImages[slug]}
                  class="et--partners__logo"
                  style="object-fit: contain;"
                  alt={name}
                  width={400}
                />
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
